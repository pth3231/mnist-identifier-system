# Backend Configuration

## Database
DATABASE_URL=postgresql://user:password@localhost:5432/mnist_identifier
# For SQLite (dev only): sqlite+aiosqlite:///./mnist_identifier.db

## Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

## Redis (for session/caching)
REDIS_URL=redis://redis:6379/0

## RabbitMQ (for logging)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

## ML Model
ML_MODEL_PATH=/models/mnist_trained/mnist_model_fp16.pth
ML_GRPC_PORT=50051

## Gateway
GATEWAY_PORT=8080
REQUEST_TIMEOUT_MS=5000
MAX_RETRIES=2

## Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
