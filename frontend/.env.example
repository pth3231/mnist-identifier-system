# Docker Production Environment
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=secure_db_password_change_me
POSTGRES_DB=mnist_identifier

# Backend Configuration
DATABASE_URL=postgresql://dbuser:secure_db_password_change_me@db:5432/mnist_identifier
SECRET_KEY=your-production-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Configuration
MODEL_PATH=/ml/mnist_model_fp16.pth
NUM_CLASSES=10
INPUT_SIZE=784

# Environment
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000
